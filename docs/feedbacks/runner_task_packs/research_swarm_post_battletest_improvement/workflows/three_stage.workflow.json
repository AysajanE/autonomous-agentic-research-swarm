{
  "schema_version": "responses_runner_v2.workflow_manifest.v1",
  "workflow_id": "research_swarm_post_battletest_improvement",
  "workflow_name": "Research Swarm Post-Battle-Test Improvement",
  "workflow_mode": "reviewed_three_stage",
  "description": "Design and finalize the next general improvement packet for autonomous-agentic-research-swarm after the first full battle test, using the empirical run as evidence rather than as the redesign boundary.",
  "shared_instructions_file": "../shared_instructions.md",
  "operator_requirements": {
    "minimum_primary_job_inputs": 0,
    "maximum_primary_job_inputs": 0,
    "allow_reference_context": false
  },
  "defaults": {
    "model_roles": {
      "primary_generation": {
        "model": "gpt-5.4-pro",
        "reasoning_effort": "xhigh",
        "verbosity": "high",
        "prompt_cache_retention": "in_memory"
      },
      "structural_processing": {
        "model": "gpt-5.4",
        "reasoning_effort": "high",
        "verbosity": "medium",
        "prompt_cache_retention": "24h"
      }
    },
    "request": {
      "background": true,
      "store": true,
      "parallel_tool_calls": true,
      "max_tool_calls": 128,
      "service_tier": "default",
      "token_preflight": {
        "enabled": true,
        "max_retries": 2,
        "retryable_http_status_codes": [
          429,
          500,
          502,
          503,
          504
        ],
        "on_retryable_service_failure": "continue_without_token_count"
      },
      "file_uploads": {
        "purpose": "user_data",
        "delete_on_completion": false,
        "expires_after_seconds": 604800
      }
    }
  },
  "stages": [
    {
      "stage_id": "diagnosis_and_evidence_lock",
      "stage_number": 1,
      "title": "Diagnosis And Evidence Lock",
      "task_file": "../prompts/stage1_diagnosis_and_evidence_lock.md",
      "input_manifest_file": "../inputs/stage1.input_manifest.json",
      "tool_profile_file": "../tools/stage1_web_search.profile.json",
      "model_role": "primary_generation",
      "max_output_tokens": 128000,
      "gate": "review_required",
      "output": {
        "primary_format": "text"
      }
    },
    {
      "stage_id": "target_architecture_and_change_contract",
      "stage_number": 2,
      "title": "Target Architecture And Change Contract",
      "task_file": "../prompts/stage2_target_architecture_and_change_contract.md",
      "input_manifest_file": "../inputs/stage2.input_manifest.json",
      "tool_profile_file": "../tools/no_tools.profile.json",
      "model_role": "primary_generation",
      "max_output_tokens": 128000,
      "gate": "review_required",
      "carry_forward": {
        "review_bundle_from_stage_id": "diagnosis_and_evidence_lock",
        "review_bundle_include_response_artifact_json": false
      },
      "output": {
        "primary_format": "text"
      }
    },
    {
      "stage_id": "final_drop_in_packet",
      "stage_number": 3,
      "title": "Final Drop-In Packet",
      "task_file": "../prompts/stage3_final_drop_in_packet.md",
      "input_manifest_file": "../inputs/stage3.input_manifest.json",
      "tool_profile_file": "../tools/no_tools.profile.json",
      "model_role": "primary_generation",
      "max_output_tokens": 128000,
      "gate": "terminal",
      "carry_forward": {
        "review_bundle_from_stage_id": "target_architecture_and_change_contract",
        "review_bundle_include_response_artifact_json": false
      },
      "output": {
        "primary_format": "text"
      }
    }
  ]
}
