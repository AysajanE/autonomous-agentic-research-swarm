{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_swarm.literature_manifest.v1",
  "type": "object",
  "required": ["schema_version", "acquisition_id", "retrieved_on", "acquisition_method", "search_strategy", "entries"],
  "properties": {
    "schema_version": {"const": "research_swarm.literature_manifest.v1"},
    "acquisition_id": {"type": "string", "minLength": 1},
    "retrieved_on": {"type": "string", "format": "date"},
    "acquisition_method": {"enum": ["live", "fixture"]},
    "search_strategy": {
      "type": "object",
      "required": ["databases", "queries", "inclusion_criteria", "executor_family"]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["citekey", "url", "resolved_url", "acquisition_method", "response_metadata", "snapshot_path", "snapshot_sha256", "snapshot_bytes"],
        "properties": {
          "citekey": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "resolved_url": {"type": "string", "minLength": 1},
          "acquisition_method": {"enum": ["live", "fixture"]},
          "response_metadata": {"type": "object"},
          "snapshot_path": {"type": "string", "minLength": 1},
          "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "snapshot_bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
