{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_swarm.exhibits_manifest.v1.schema",
  "title": "Research swarm exhibits manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_by", "exhibits"],
  "properties": {
    "schema_version": {"const": "research_swarm.exhibits_manifest.v1"},
    "generated_by": {"type": "string", "minLength": 1},
    "exhibits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exhibit_id", "builder", "inputs", "output", "caption", "notes", "self_qa"],
        "properties": {
          "exhibit_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "builder": {"type": "string", "minLength": 1},
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "output": {"type": "string", "minLength": 1},
          "caption": {"type": "string", "minLength": 1},
          "notes": {"type": "string"},
          "self_qa": {
            "type": "object",
            "additionalProperties": false,
            "required": ["labels", "legend", "units", "alt_text"],
            "properties": {
              "labels": {"const": true},
              "legend": {"const": true},
              "units": {"const": true},
              "alt_text": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
