{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_swarm.instance_manifest.v1.schema",
  "title": "Research swarm instance manifest v1",
  "$defs": {
    "hashed_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "hashed_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "validation_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "status"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"type": "string", "enum": ["green", "ok", "passed"]}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clause_id", "choice", "rationale"],
      "properties": {
        "clause_id": {"type": "string", "minLength": 1},
        "choice": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "instance_id",
        "source_processed_manifests",
        "generator_command",
        "generated_at_utc",
        "outputs"
      ],
      "properties": {
        "schema_version": {"const": "research_swarm.instance_manifest.v1"},
        "instance_id": {"type": "string", "minLength": 1},
        "source_processed_manifests": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/hashed_source"}
        },
        "generator_command": {"type": "string", "minLength": 1},
        "generated_at_utc": {"type": "string", "format": "date-time"},
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/hashed_output"}
        },
        "pre_bridge_validation": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/validation_artifact"}
        },
        "decision_log": {
          "type": "array",
          "items": {"$ref": "#/$defs/decision"}
        }
      }
    },
    "synthetic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "instance_id",
        "generator_command",
        "parameter_ranges",
        "seeds",
        "git_sha",
        "outputs"
      ],
      "properties": {
        "schema_version": {"const": "research_swarm.instance_manifest.v1"},
        "instance_id": {"type": "string", "minLength": 1},
        "generator_command": {"type": "string", "minLength": 1},
        "parameter_ranges": {"type": "object", "minProperties": 1},
        "seeds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer"}
        },
        "git_sha": {"type": "string", "minLength": 7},
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/hashed_output"}
        },
        "decision_log": {
          "type": "array",
          "items": {"$ref": "#/$defs/decision"}
        }
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/bridge"},
    {"$ref": "#/$defs/synthetic"}
  ]
}
