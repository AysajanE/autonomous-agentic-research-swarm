{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_swarm.processed_manifest.v2.schema",
  "type": "object",
  "required": ["schema_version", "as_of_utc_date", "inputs", "transform", "outputs", "environment"],
  "properties": {
    "schema_version": {"const": "research_swarm.processed_manifest.v2"},
    "as_of_utc_date": {"type": "string"},
    "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "transform": {"type": "object", "required": ["script_path", "script_sha256", "git_sha", "command", "dirty"], "properties": {"script_path": {"type": "string", "minLength": 1}, "script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "git_sha": {"type": "string", "minLength": 1}, "command": {"type": "string", "minLength": 1}, "dirty": {"type": "boolean"}, "tree_diff": {"type": "string"}}},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}}},
    "environment": {"type": "object", "required": ["dependencies"], "properties": {"dependencies": {"type": "object"}}}
  }
}
