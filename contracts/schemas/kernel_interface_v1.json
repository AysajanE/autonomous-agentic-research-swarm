{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_swarm.kernel_interface.v1.schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kernel_version", "task_schema_version", "manifest_schema_versions", "gate_registration_api_version", "executor_config_version", "reserved_claim_ref_namespaces", "semver_policy"],
  "properties": {
    "schema_version": {"const": "research_swarm.kernel_interface.v1"},
    "kernel_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "task_schema_version": {"type": "string", "minLength": 1},
    "manifest_schema_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "gate_registration_api_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "executor_config_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "reserved_claim_ref_namespaces": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "semver_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["breaking_changes", "additive_changes", "compatible_fixes"],
      "properties": {
        "breaking_changes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "additive_changes": {"const": "minor"},
        "compatible_fixes": {"const": "patch"}
      }
    }
  }
}
