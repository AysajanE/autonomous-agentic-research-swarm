{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_swarm.experiment_spec.v1.schema",
  "title": "Locked experiment-design surface v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "grid",
    "seeds",
    "solver",
    "budget",
    "convergence_tolerance",
    "sweep_survival_criterion"
  ],
  "properties": {
    "schema_version": {"const": "research_swarm.experiment_spec.v1"},
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions"],
      "properties": {
        "dimensions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": ["string", "number", "integer", "boolean"]}
          }
        }
      }
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer"}
    },
    "solver": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "budget": {
      "oneOf": [
        {"type": "number", "exclusiveMinimum": 0},
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "number", "exclusiveMinimum": 0}
        }
      ]
    },
    "convergence_tolerance": {"type": "number", "minimum": 0},
    "sweep_survival_criterion": {"type": "number", "minimum": 0}
  }
}
