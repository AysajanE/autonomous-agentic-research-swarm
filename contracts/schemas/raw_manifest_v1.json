{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_swarm.raw_manifest.v1.schema",
  "type": "object",
  "required": ["schema_version", "source", "as_of_utc_date", "fetched_at_utc", "command", "files", "environment"],
  "properties": {
    "schema_version": {"const": "research_swarm.raw_manifest.v1"},
    "source": {"type": "string", "minLength": 1},
    "as_of_utc_date": {"type": "string"},
    "fetched_at_utc": {"type": "string", "format": "date-time"},
    "command": {"type": "string", "minLength": 1},
    "files": {"type": "array", "items": {"type": "object", "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}}},
    "environment": {"type": "object"}
  }
}
