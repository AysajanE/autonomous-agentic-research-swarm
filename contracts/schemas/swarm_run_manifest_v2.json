{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_swarm.runtime_run_manifest.v2.schema",
  "type": "object",
  "required": ["schema_version", "provenance_class", "run_id", "generated_at_utc", "task", "repo", "executor", "commands", "gates", "ownership", "artifacts", "result"],
  "properties": {
    "schema_version": {"const": "research_swarm.runtime_run_manifest.v2"},
    "provenance_class": {"enum": ["executor_run", "manual_operator", "backfill"]},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "task": {"type": "object", "required": ["task_id", "task_path", "role", "workstream", "state_before", "state_after"]},
    "repo": {"type": "object", "required": ["branch", "git_sha", "base_branch", "remote"]},
    "executor": {"type": "object", "required": ["role", "runner", "tool", "allow_network"]},
    "commands": {"type": "object", "required": ["executor", "gates", "executor_log_path", "executor_log_sha256"]},
    "gates": {"type": ["array", "object"]},
    "ownership": {"type": "object", "required": ["ok", "changed_paths", "violations"]},
    "artifacts": {"type": "object", "required": ["outputs_ok", "missing_outputs", "required_manifests_ok", "missing_manifests"]},
    "result": {"type": "object", "required": ["status", "blocked_reasons"], "properties": {"status": {"enum": ["ok", "blocked"]}}}
  }
}
